{
  "name": "promisegraph",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:controlled": "node --import tsx --test tests/ai.test.ts tests/api.test.ts tests/boundaries.test.ts tests/frontend.test.ts tests/tools.test.ts tests/workflows.test.ts",
    "import:folder": "node --import tsx tools/import-folder.ts",
    "memory:flush": "node --import tsx tools/flush-memory.ts",
    "setup:native": "python3 tools/setup-native.py",
    "test:boundaries": "node --import tsx --test tests/boundaries.test.ts",
    "test:ai": "node --import tsx --test tests/ai.test.ts",
    "test:tools": "node --import tsx --test tests/tools.test.ts",
    "verify": "node --import tsx tools/verify.ts",
    "verify:controlled": "node --import tsx tools/verify.ts --controlled",
    "verify:ai": "node --import tsx tools/verify.ts --ai-only"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "falkordb": "^6.8.0",
    "falkordblite": "^0.3.0",
    "get-port": "^7.2.0",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "openai": "^7.34.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "class-variance-authority": "0.7.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.49.0",
    "@radix-ui/react-slot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "@falkordblite/darwin-arm64": "^8.2.3-falkordb.4.16.3",
    "@falkordblite/linux-x64": "^8.2.3-falkordb.4.16.3"
  }
}
